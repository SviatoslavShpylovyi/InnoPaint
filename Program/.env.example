# Copy to .env (gitignored) and fill in. Used by docker-compose.yml.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=InnoPaint
MYSQL_USER=innopaint
MYSQL_PASSWORD=change-me

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Host port for the store (web + proxied API).
WEB_PORT=8080

# Image names for `docker compose build/push`; defaults: innopaint/*:latest.
REGISTRY=
TAG=

# Optional nginx basic auth; empty = off. Single quotes: the bcrypt hash has $ signs.
# docker run --rm httpd:2.4-alpine htpasswd -nbB dev '<password>'
BASIC_AUTH_HTPASSWD=
