# Serves the built SPA and proxies the API on the same origin, mirroring the
# Vite dev proxy, so the API still needs no CORS policy.
# Template: the nginx image substitutes ${API_UPSTREAM} at start-up. Only
# variables set in the environment are replaced, so $host etc. stay intact.

# Keep the scheme set by a TLS-terminating proxy in front of nginx (Azure
# Container Apps ingress); fall back to nginx's own scheme when there is none.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Basic auth for everything below. 05-basic-auth.envsh sets the realm to
    # "off" when BASIC_AUTH_HTPASSWD is empty (local compose).
    auth_basic "${BASIC_AUTH_REALM}";
    auth_basic_user_file /etc/nginx/.htpasswd;

    # Probe endpoint: no password and no API call, so the API can scale to zero.
    location = /healthz {
        auth_basic off;
        access_log off;
        return 200;
    }

    location /api/ {
        # Host stays the upstream's own name: Container Apps ingress routes by
        # Host. The public host travels in X-Forwarded-Host instead.
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # The palette assistant waits on the LLM.
        proxy_read_timeout 120s;
    }

    location = /health {
        proxy_pass ${API_UPSTREAM};
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
