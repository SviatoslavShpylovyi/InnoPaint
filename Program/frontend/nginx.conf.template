# Serves the built SPA and proxies the API on the same origin, mirroring the
# Vite dev proxy, so the API still needs no CORS policy.
# Template: the nginx image substitutes ${API_UPSTREAM} at start-up. Only
# variables set in the environment are replaced, so $host etc. stay intact.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The palette assistant waits on the LLM.
        proxy_read_timeout 120s;
    }

    location = /health {
        proxy_pass ${API_UPSTREAM};
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
